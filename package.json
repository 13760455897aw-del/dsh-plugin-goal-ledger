{
  "name": "dsh-plugin-goal-ledger",
  "version": "0.2.0",
  "description": "目标日志：把一个长会话折叠成任务树（当前任务红点、完成划线、每件事留结论），规则层零成本兜底、模型层每轮一次小归纳，不进入模型上下文。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/ledger.js",
    "lib/model-ledger.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "HOST-CONSTRAINTS.md",
    "DESIGN-PAPER.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "goal",
    "task",
    "ledger",
    "session",
    "agent",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/13760455897aw-del/dsh-plugin-goal-ledger.git"
  },
  "homepage": "https://github.com/13760455897aw-del/dsh-plugin-goal-ledger#readme",
  "bugs": {
    "url": "https://github.com/13760455897aw-del/dsh-plugin-goal-ledger/issues"
  },
  "author": "hzvezda",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
